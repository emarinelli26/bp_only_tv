{
  "manifest_version": 3,
  "name": "TV menu navigation",
  "version": "1.2",
  "description": "Controller navigation for the BigPictureTV TV menu: arrow keys move a focus box over links, buttons and video players.",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["spatial-nav.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["player.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
