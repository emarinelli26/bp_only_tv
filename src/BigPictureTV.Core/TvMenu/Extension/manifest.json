{
  "manifest_version": 3,
  "name": "TV menu navigation",
  "version": "1.1",
  "description": "Moves a focus box between links and buttons with the arrow keys, and works video players, for the BigPictureTV TV menu.",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["spatial-nav.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["player.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
